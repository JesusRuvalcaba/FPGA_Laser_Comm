#include <stdint.h>
#include "chu_init.h"
#include "xadc_core.h"
#include "gpio_cores.h"
#include "ps2_core.h"
#include "vga_core.h"

XadcCore adc(get_slot_addr(BRIDGE_BASE, S5_XDAC));
GpoCore laser(get_slot_addr(BRIDGE_BASE, S2_LED));
GpiCore btn(get_slot_addr(BRIDGE_BASE, S7_BTN));
Ps2Core ps2(get_slot_addr(BRIDGE_BASE, S11_PS2));

FrameCore frame(FRAME_BASE);

const int BLACK = 0x000;
const int RED   = 0xF00;
const int GREEN = 0x0F0;
const int BLUE  = 0x00F;
const int WHITE = 0xFFF;

int bg_color = BLACK;

int ball_x = 320;
int ball_y = 240;

const int BALL_R = 12;
const int MOVE_STEP = 25;

/* ===================== FONT ===================== */

const uint8_t FONT_SPACE[7] = {0,0,0,0,0,0,0};
const uint8_t FONT_A[7] = {0x0E,0x11,0x11,0x1F,0x11,0x11,0x11};
const uint8_t FONT_B[7] = {0x1E,0x11,0x11,0x1E,0x11,0x11,0x1E};
const uint8_t FONT_C[7] = {0x0E,0x11,0x10,0x10,0x10,0x11,0x0E};
const uint8_t FONT_D[7] = {0x1E,0x11,0x11,0x11,0x11,0x11,0x1E};
const uint8_t FONT_E[7] = {0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F};
const uint8_t FONT_F[7] = {0x1F,0x10,0x10,0x1E,0x10,0x10,0x10};
const uint8_t FONT_G[7] = {0x0E,0x11,0x10,0x17,0x11,0x11,0x0E};
const uint8_t FONT_H[7] = {0x11,0x11,0x11,0x1F,0x11,0x11,0x11};
const uint8_t FONT_I[7] = {0x1F,0x04,0x04,0x04,0x04,0x04,0x1F};
const uint8_t FONT_K[7] = {0x11,0x12,0x14,0x18,0x14,0x12,0x11};
const uint8_t FONT_L[7] = {0x10,0x10,0x10,0x10,0x10,0x10,0x1F};
const uint8_t FONT_M[7] = {0x11,0x1B,0x15,0x15,0x11,0x11,0x11};
const uint8_t FONT_N[7] = {0x11,0x19,0x15,0x13,0x11,0x11,0x11};
const uint8_t FONT_O[7] = {0x0E,0x11,0x11,0x11,0x11,0x11,0x0E};
const uint8_t FONT_P[7] = {0x1E,0x11,0x11,0x1E,0x10,0x10,0x10};
const uint8_t FONT_R[7] = {0x1E,0x11,0x11,0x1E,0x14,0x12,0x11};
const uint8_t FONT_S[7] = {0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E};
const uint8_t FONT_T[7] = {0x1F,0x04,0x04,0x04,0x04,0x04,0x04};
const uint8_t FONT_U[7] = {0x11,0x11,0x11,0x11,0x11,0x11,0x0E};
const uint8_t FONT_W[7] = {0x11,0x11,0x11,0x15,0x15,0x1B,0x11};
const uint8_t FONT_Y[7] = {0x11,0x11,0x0A,0x04,0x04,0x04,0x04};
const uint8_t FONT_COLON[7] = {0x00,0x04,0x04,0x00,0x04,0x04,0x00};

const uint8_t* get_font(char c) {

    if (c >= 'a' && c <= 'z')
        c -= 32;

    switch (c) {

        case 'A': return FONT_A;
        case 'B': return FONT_B;
        case 'C': return FONT_C;
        case 'D': return FONT_D;
        case 'E': return FONT_E;
        case 'F': return FONT_F;
        case 'G': return FONT_G;
        case 'H': return FONT_H;
        case 'I': return FONT_I;
        case 'K': return FONT_K;
        case 'L': return FONT_L;
        case 'M': return FONT_M;
        case 'N': return FONT_N;
        case 'O': return FONT_O;
        case 'P': return FONT_P;
        case 'R': return FONT_R;
        case 'S': return FONT_S;
        case 'T': return FONT_T;
        case 'U': return FONT_U;
        case 'W': return FONT_W;
        case 'Y': return FONT_Y;
        case ':': return FONT_COLON;
        case ' ': return FONT_SPACE;

        default:
            return FONT_SPACE;
    }
}

/* ===================== TEXT ===================== */

void draw_char_px(int x0,
                  int y0,
                  char c,
                  int color,
                  int scale) {

    const uint8_t *glyph = get_font(c);

    for (int row = 0; row < 7; row++) {

        for (int col = 0; col < 5; col++) {

            if (glyph[row] & (1 << (4 - col))) {

                for (int yy = 0; yy < scale; yy++) {

                    for (int xx = 0; xx < scale; xx++) {

                        int x = x0 + col * scale + xx;
                        int y = y0 + row * scale + yy;

                        if (x >= 0 && x < 640 &&
                            y >= 0 && y < 480) {

                            frame.wr_pix(x, y, color);
                        }
                    }
                }
            }
        }
    }
}

void draw_text_px(int x,
                  int y,
                  const char *s,
                  int color,
                  int scale) {

    int i = 0;

    while (s[i] != '\0') {

        draw_char_px(x + i * 6 * scale,
                     y,
                     s[i],
                     color,
                     scale);

        i++;
    }
}

/* ===================== BALL ===================== */

void draw_ball_at(int cx,
                  int cy,
                  int color) {

    for (int y = cy - BALL_R;
         y <= cy + BALL_R;
         y++) {

        for (int x = cx - BALL_R;
             x <= cx + BALL_R;
             x++) {

            if (x >= 0 && x < 640 &&
                y >= 0 && y < 480) {

                int dx = x - cx;
                int dy = y - cy;

                if ((dx * dx + dy * dy)
                    <= (BALL_R * BALL_R)) {

                    frame.wr_pix(x, y, color);
                }
            }
        }
    }
}

void draw_ball() {

    draw_ball_at(ball_x,
                 ball_y,
                 BLUE);
}

void erase_ball(int cx,
                int cy) {

    draw_ball_at(cx,
                 cy,
                 bg_color);
}

/* ===================== INPUT AREA ===================== */

void draw_input_area(const char *input_text) {

    for (int y = 0; y < 40; y++) {

        for (int x = 400; x < 640; x++) {

            frame.wr_pix(x,
                         y,
                         bg_color);
        }
    }

    draw_text_px(410,
                 20,
                 "INPUT:",
                 WHITE,
                 2);

    draw_text_px(500,
                 20,
                 input_text,
                 WHITE,
                 2);
}

/* ===================== STATUS COLOR BOX ===================== */

void draw_status_box(int color) {

    for (int y = 430; y < 470; y++) {

        for (int x = 20; x < 260; x++) {

            frame.wr_pix(x,
                         y,
                         color);
        }
    }
}

/* ===================== STATIC SCREEN ===================== */

void draw_static_screen() {

    frame.bypass(0);

    frame.clr_screen(bg_color);

    draw_ball();

    draw_text_px(20,
                 40,
                 "TYPE A COMMAND",
                 WHITE,
                 2);

    draw_text_px(20,
                 80,
                 "UP DOWN LEFT RIGHT",
                 WHITE,
                 2);

    draw_text_px(20,
                 120,
                 "PRESS ENTER",
                 WHITE,
                 2);

    draw_input_area("");

    draw_status_box(BLACK);
}

/* ===================== COMMANDS ===================== */

bool command_equals(const char *cmd,
                    const char *target) {

    int i = 0;

    while (cmd[i] != '\0' &&
           target[i] != '\0') {

        char a = cmd[i];
        char b = target[i];

        if (a >= 'a' && a <= 'z')
            a -= 32;

        if (b >= 'a' && b <= 'z')
            b -= 32;

        if (a != b)
            return false;

        i++;
    }

    return cmd[i] == '\0' &&
           target[i] == '\0';
}

bool move_ball_command(const char *cmd) {

    bool recognized = true;

    int old_x = ball_x;
    int old_y = ball_y;

    if (command_equals(cmd, "UP")) {

        ball_y -= MOVE_STEP;
    }
    else if (command_equals(cmd, "DOWN")) {

        ball_y += MOVE_STEP;
    }
    else if (command_equals(cmd, "LEFT")) {

        ball_x -= MOVE_STEP;
    }
    else if (command_equals(cmd, "RIGHT")) {

        ball_x += MOVE_STEP;
    }
    else {

        recognized = false;
    }

    if (ball_x < BALL_R)
        ball_x = BALL_R;

    if (ball_x > 639 - BALL_R)
        ball_x = 639 - BALL_R;

    if (ball_y < BALL_R)
        ball_y = BALL_R;

    if (ball_y > 479 - BALL_R)
        ball_y = 479 - BALL_R;

    /*
     * FULL SCREEN BACKGROUND CHANGE
     */

    if (recognized) {

        bg_color = GREEN;
    }
    else {

        bg_color = RED;
    }

    /*
     * redraw entire frame
     */

    frame.clr_screen(bg_color);

    /*
     * redraw all objects/text
     */

    draw_ball();

    draw_text_px(20,
                 40,
                 "TYPE A COMMAND",
                 WHITE,
                 2);

    draw_text_px(20,
                 80,
                 "UP DOWN LEFT RIGHT",
                 WHITE,
                 2);

    draw_text_px(20,
                 120,
                 "PRESS ENTER",
                 WHITE,
                 2);

    draw_input_area("");

    return recognized;
}

/* ===================== OPTICAL ===================== */

uint16_t read_brightness() {

    uint16_t raw =
        adc.read_raw(2);

    return raw >> 4;
}

uint16_t pwm_symbol_and_average(uint8_t symbol) {

    const int period_us = 10000;

    int duty_us;

    if (symbol == 0b00)
        duty_us = 0;

    else if (symbol == 0b01)
        duty_us = period_us / 3;

    else if (symbol == 0b10)
        duty_us = (period_us * 2) / 3;

    else
        duty_us = period_us;

    uint32_t sum = 0;

    int samples = 0;

    for (int t = 0;
         t < period_us;
         t += 100) {

        if (t < duty_us)
            laser.write(1);

        else
            laser.write(0);

        sleep_us(100);

        sum += read_brightness();

        samples++;
    }

    laser.write(0);

    return sum / samples;
}

uint8_t brightness_to_symbol(uint16_t brightness) {

    if (brightness > 3000)
        return 0b00;

    else if (brightness > 1700)
        return 0b01;

    else if (brightness > 400)
        return 0b10;

    else
        return 0b11;
}

uint8_t transmit_and_receive_byte(uint8_t byte) {

    uint8_t rx_byte = 0;

    for (int j = 3; j >= 0; j--) {

        uint8_t tx_symbol =
            (byte >> (j * 2)) & 0x03;

        uint16_t avg_brightness =
            pwm_symbol_and_average(tx_symbol);

        uint8_t rx_symbol =
            brightness_to_symbol(avg_brightness);

        rx_byte = (rx_byte << 2)
                | rx_symbol;
    }

    return rx_byte;
}

/* ===================== CALIBRATION ===================== */

void calibrate() {

    uint8_t symbols[4] =
        {0b00, 0b01, 0b10, 0b11};

    uart.disp("\n\r--- CALIBRATION START ---\n\r");

    for (int i = 0; i < 4; i++) {

        uint16_t avg =
            pwm_symbol_and_average(symbols[i]);

        uint8_t rx_symbol =
            brightness_to_symbol(avg);

        uart.disp("TX Symbol: ");

        uart.disp((symbols[i] >> 1) & 1);

        uart.disp(symbols[i] & 1);

        uart.disp(" Avg: ");

        uart.disp((int)avg);

        uart.disp(" RX Symbol: ");

        uart.disp((rx_symbol >> 1) & 1);

        uart.disp(rx_symbol & 1);

        uart.disp("\n\r");
    }

    uart.disp("--- CALIBRATION END ---\n\r");
}

/* ===================== MAIN CHAT ===================== */

void transmitter() {

    char msg[128];
    char rx_msg[128];

    while (1) {

        int index = 0;

        msg[0] = '\0';

        draw_input_area("");

        while (1) {

            if (btn.read() & 0x10) {

                calibrate();

                sleep_ms(500);
            }

            char c;

            if (!ps2.get_kb_ch(&c))
                continue;

            if (c == '\r' || c == '\n') {

                msg[index] = '\0';

                draw_input_area("");

                break;
            }

            if (c == 8 || c == 127) {

                if (index > 0) {

                    index--;

                    msg[index] = '\0';

                    draw_input_area(msg);
                }

                continue;
            }

            if (index < 127) {

                msg[index++] = c;

                msg[index] = '\0';

                draw_input_area(msg);
            }
        }

        int rx_index = 0;

        for (int i = 0;
             msg[i] != '\0';
             i++) {

            uint8_t tx_byte =
                (uint8_t)msg[i];

            uint8_t rx_byte =
                transmit_and_receive_byte(tx_byte);

            if (rx_index < 127) {

                rx_msg[rx_index++] =
                    (char)rx_byte;
            }
        }

        rx_msg[rx_index] = '\0';

        move_ball_command(rx_msg);
    }
}

/* ===================== MAIN ===================== */

int main() {

    uart.set_baud_rate(9600);

    draw_static_screen();

    transmitter();

    return 0;
}
